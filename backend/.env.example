# 复制成 .env 后按需改（systemd 会加载它）
# cp .env.example .env && chmod 600 .env

# 数据与静态目录（默认就在项目里，一般不用改）
# LOVE_DATA_DIR=/opt/love-memoir-api/data
# LOVE_STATIC_DIR=/opt/love-memoir-api/static

# 生成分享链接用的公网前缀
LOVE_PUBLIC_BASE_URL=https://love.ccflysim.cn

# 允许跨域的前端地址（同域反代时其实用不到，本地开发用得到）
LOVE_ALLOWED_ORIGINS=https://love.ccflysim.cn,http://localhost:5174,http://127.0.0.1:5174

# 上传限制
LOVE_MAX_PHOTOS=20
LOVE_MAX_PHOTO_BYTES=8388608
LOVE_MAX_TOTAL_BYTES=83886080
LOVE_UPLOADS_PER_HOUR=20

# 服务端二次压缩
LOVE_IMAGE_MAX_SIDE=1600
LOVE_IMAGE_QUALITY=82

# 存 IP 哈希前加的盐，必须改成一串随机值
LOVE_IP_SALT=change-this-to-a-random-string
